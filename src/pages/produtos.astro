    ]
  },
  {
    name: "SENSCIENCE",
    products: [
      

      { name: "C.P.R. Step 1 & 2", image: "/cpr2.png", price: "Sob consulta" },
      { name: "C.P.R. Step 1, 2, 3 & 4", image: "/cpr4.png", price: "Sob consulta" },
      
    ]
  },
  {
    name: "L'ORÉAL PROFESSIONNEL",
    products: [
      { name: "Pro Longer", image: "/pro.png", price: "Sob consulta" },
     
    ]
  },
  {
    name: "MAISON VISAGE",
    products: [
      { name: "Metal Cleaning", image: "/METAL.png", price: "Sob consulta" },
      
    ]
  },
  {
    name: "MIRRA COSMÉTICOS",
    products: [
      { name: "Bio-Restore System", image: "/bio.png", price: "Sob consulta" },
      
    ]
  },
  {
    name: "ERIK KENED",
    products: [
      { name: "Infusion Oil", image: "/infusion.png", price: "Sob consulta" },
     
    ]
  },
  {
    name: "VEVVO",
    products: [
      { name: "VEVVO Blond", image: "/blond.jpg", price: "Sob consulta" },
      
    ]
  },
  {
    name: "MED",
    products: [
      { name: "Nutri Drops", image: "/nutri.png", price: "Sob consulta" },
      
    ]
  }
